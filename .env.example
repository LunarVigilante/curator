# =============================================================================
# CURATOR - ENVIRONMENT CONFIGURATION
# =============================================================================
# Instructions:
# 1. Copy this file to `.env`
# 2. Fill in the required values below.
# 3. Restart your development server.

# -----------------------------------------------------------------------------
# 1. DATABASE (Supabase) - REQUIRED
# -----------------------------------------------------------------------------
# Get these credentials from your Supabase project settings -> Database.

# Transaction Pooler (Port 6543) - Optimized for application queries
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) - Required for migrations
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION & APP CONFIG - REQUIRED
# -----------------------------------------------------------------------------
# App URL used for callbacks, email links, and redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 3. CONTENT & MEDIA APIS - HIGHLY RECOMMENDED
# -----------------------------------------------------------------------------
# These keys enable the auto-fetching of metadata for movies, games, books, etc.
# Without them, you will have to manually enter all item details.

# Movies & TV (TMDB) - https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Video Games (RAWG) - https://rawg.io/apidocs
RAWG_API_KEY=

# Books (Google Books) - https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Music (Spotify) - https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Comics (ComicVine) - https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=

# Board Games (BGG) - https://boardgamegeek.com/wiki/page/XML_API_Terms_of_Use
BGG_API_KEY=

# -----------------------------------------------------------------------------
# 4. LLM / AI CONFIGURATION - OPTIONAL
# -----------------------------------------------------------------------------
# Enables AI features like "Smart Sorting", "AI Critic", and "Recommendations".
# Supported: openai, anthropic, openrouter, google, ollama

# Provider Choice (openai | anthropic | openrouter | google | ollama)
LLM_PROVIDER="openrouter"

# Model Selection
# Recommended: 'claude-3-5-haiku-latest' (fast/cheap) or 'gpt-4o-mini'
LLM_MODEL="claude-3-5-haiku-latest"

# API Keys (Fill in the one matching your provider)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Custom Endpoint (for Ollama or proxies)
# LLM_ENDPOINT="http://localhost:11434"

# -----------------------------------------------------------------------------
# 5. EMAIL SERVICE (Resend) - OPTIONAL
# -----------------------------------------------------------------------------
# Required for sending "Magic Links" and password resets in production.
# https://resend.com/api-keys

RESEND_API_KEY=
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# -----------------------------------------------------------------------------
# 6. FEATURE FLAGS - ADVANCED
# -----------------------------------------------------------------------------
# Toggle specific capabilities of the application.

NEXT_PUBLIC_ENABLE_AI_CRITIC=true
NEXT_PUBLIC_ENABLE_SMART_SORT=true
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true
NEXT_PUBLIC_ENABLE_CHALLENGES=true

# -----------------------------------------------------------------------------
# 7. SEEDING & ADMIN - DEV ONLY
# -----------------------------------------------------------------------------
# Use these to seed the database with initial users/items.

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

SEED_DEFAULT_PASSWORD="Password123!"
SEED_ADMIN_COUNT=2
SEED_CRITIC_COUNT=10
SEED_USER_COUNT=50
SEED_ITEMS_PER_USER=5

# -----------------------------------------------------------------------------
# 8. CUSTOM API ENDPOINTS - ADVANCED
# -----------------------------------------------------------------------------
# Override default endpoints if using proxies or self-hosted instances.

# TMDB_API_URL="https://api.themoviedb.org/3"
# RAWG_API_URL="https://api.rawg.io/api"

# Copy this file to .env and fill in your values.
# API keys added here will be seeded into the database and can be updated via the Admin GUI.

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================


# For Supabase production, use both URLs:
# Transaction Pooler (Port 6543) - for app queries with connection pooling
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct/Session Connection (Port 5432) - for Prisma migrations
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# =============================================================================
# AUTHENTICATION
# =============================================================================



# App URL (used for callbacks and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# GOLDEN TICKET ADMIN (for database seeding)
# =============================================================================
# These credentials are used to create your personal admin account during seeding.
# If left blank, you can still use admin1@curator.local / Password123!

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# =============================================================================
# SEED CONFIGURATION
# =============================================================================
# Control how many users and items are created during seeding

SEED_DEFAULT_PASSWORD=Password123!
SEED_ADMIN_COUNT=2
SEED_CRITIC_COUNT=10
SEED_USER_COUNT=50
SEED_ITEMS_PER_USER=5

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Supported providers: openai, anthropic, openrouter, google, ollama
#
# Set LLM_PROVIDER to your choice, then fill in the corresponding API key below.

# Active LLM Provider (openai | anthropic | openrouter | google | ollama)
LLM_PROVIDER=openrouter

# Model to use (examples below)
# - Anthropic: claude-3-5-haiku-latest, claude-3-5-sonnet-latest, claude-3-opus-latest
# - OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# - Google: gemini-1.5-flash, gemini-1.5-pro
# - OpenRouter: anthropic/claude-3.5-sonnet, openai/gpt-4o
LLM_MODEL=claude-3-5-haiku-latest

# Custom endpoint (optional - for Ollama, OpenRouter, or self-hosted)
LLM_ENDPOINT=


# -----------------------------------------------------------------------------
# ANTHROPIC (Direct) - https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# OPENAI - https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# OPENROUTER - https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# GOOGLE AI (Gemini) - https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GOOGLE_AI_API_KEY=

# -----------------------------------------------------------------------------
# OLLAMA (Local) - No API key needed, just set endpoint
# -----------------------------------------------------------------------------
# LLM_ENDPOINT=http://localhost:11434
# LLM_MODEL=llama3.2

# =============================================================================
# MEDIA API KEYS
# =============================================================================
# These are used for auto-fetching metadata for movies, games, books, and music.

# TMDB (Movies & TV) - Get key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# RAWG (Video Games) - Get key at: https://rawg.io/apidocs
RAWG_API_KEY=

# Google Books API - Get key at: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Spotify (Music) - Get credentials at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ComicVine (Comics) - Get key at: https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=

# BoardGameGeek (Board Games) - Register at: https://boardgamegeek.com/wiki/page/XML_API_Terms_of_Use
BGG_API_KEY=

# =============================================================================
# EMAIL CONFIGURATION (Resend)
# =============================================================================
# Used for email verification, password resets, and 2FA codes.
# Get your API key at: https://resend.com/api-keys

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com



# =============================================================================
# AI MEMORY & RECOMMENDATIONS (Vector DB) - COMING SOON
# =============================================================================
# For AI recommendations, the LLM needs a vector database to understand semantic similarity.
# This allows the AI to understand that "Neon Genesis Evangelion" is similar to "Attack on Titan".
# Options: pinecone, upstash, weaviate, supabase (pgvector)

# Embedding Provider (usually same as your LLM, e.g., 'openai' or 'cohere')
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database Credentials
VECTOR_DB_PROVIDER=
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_INDEX=curator-items

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Toggle features to customize the app experience.

# Allow users to generate AI critiques of their lists?
NEXT_PUBLIC_ENABLE_AI_CRITIC=true

# Enable "Smart Sorting" (AI auto-sorts items into tiers based on reviews)
NEXT_PUBLIC_ENABLE_SMART_SORT=true

# Enable AI-powered recommendations based on user preferences
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true

# Enable community challenges feature
NEXT_PUBLIC_ENABLE_CHALLENGES=true

# =============================================================================
# MEDIA API ENDPOINTS (Custom URLs)
# =============================================================================
# Override default API endpoints for self-hosted or proxy setups.
# Leave empty to use default endpoints.

# TMDB (Movies & TV)
TMDB_API_URL=https://api.themoviedb.org/3

# RAWG (Video Games)
RAWG_API_URL=https://api.rawg.io/api

# Google Books
GOOGLE_BOOKS_API_URL=https://www.googleapis.com/books/v1

# Spotify
SPOTIFY_API_URL=https://api.spotify.com/v1

# AniList (Anime & Manga) - GraphQL endpoint
ANILIST_API_URL=https://graphql.anilist.co

# ComicVine (Comics)
COMICVINE_API_URL=https://comicvine.gamespot.com/api

# BoardGameGeek (Board Games)
BGG_API_URL=https://boardgamegeek.com/xmlapi2

# iTunes (Podcasts)
ITUNES_API_URL=https://itunes.apple.com

