# =============================================================================
# CURATOR - ENVIRONMENT CONFIGURATION
# =============================================================================
# Instructions:
# 1. Copy this file to `.env`
# 2. Fill in the required values below.
# 3. Restart your development server.
#
# NOTE: API keys added here are used for both server-side logic and 
# initial database seeding.

# -----------------------------------------------------------------------------
# 1. DATABASE (Supabase) - REQUIRED
# -----------------------------------------------------------------------------
# Get these credentials from your Supabase project settings -> Database.

# Transaction Pooler (Port 6543) - Optimized for application queries
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) - Required for migrations
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase API Settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbG..."

# Service Role Key (server-side only - NEVER expose to client)
# Required for admin operations that bypass Row Level Security
SUPABASE_SERVICE_ROLE_KEY="eyJhbG..."

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION & APP CONFIG - REQUIRED
# -----------------------------------------------------------------------------
# App URL used for callbacks, email links, and redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encryption key for sensitive data (API keys stored in DB)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-character-hex-string-here"

# -----------------------------------------------------------------------------
# 3. CONTENT & MEDIA APIS - HIGHLY RECOMMENDED
# -----------------------------------------------------------------------------
# These keys enable auto-fetching of metadata for movies, games, books, etc.

# Movies & TV (TMDB) - https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OMDB (Ratings) - https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Twitch / IGDB (Video Games) - https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# SteamGridDB (Game Cover Art) - https://www.steamgriddb.com/api/v2
STEAMGRIDDB_API_KEY=

# Books (Google Books) - https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Music (Spotify) - https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Comics (ComicVine) - https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=

# Comics (Metron) - https://metron.cloud/
METRON_USERNAME=
METRON_PASSWORD=

# Board Games - No API key required, uses public BGG API

# -----------------------------------------------------------------------------
# 4. AI & LLM CONFIGURATION - OPTIONAL
# -----------------------------------------------------------------------------
# Enables features like "Smart Sorting", "AI Critic", and "Recommendations".
# Supported providers: openai, anthropic, openrouter, google, ollama

# Primary AI Provider (openai | anthropic | openrouter | google | ollama)
LLM_PROVIDER="openrouter"

# Model Selection
# Recommended: 'claude-3-5-haiku-latest' (fast/cheap) or 'gpt-4o-mini'
LLM_MODEL="claude-3-5-haiku-latest"

# API Keys (Only fill the ones you use)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Voyage AI Embeddings (Vector Search) - https://dash.voyageai.com/
VOYAGE_API_KEY=

# Custom Endpoint (for Ollama or local proxies)
# LLM_ENDPOINT="http://localhost:11434"

# -----------------------------------------------------------------------------
# 5. ERROR MONITORING (Sentry) - RECOMMENDED
# -----------------------------------------------------------------------------
# Sentry integration for error tracking and performance monitoring.
# Get your DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/

# Sentry DSN (client-side, public)
NEXT_PUBLIC_SENTRY_DSN=

# Auth token for source map uploads (required for CI/CD)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# 6. FEATURE FLAGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_AI_CRITIC=true
NEXT_PUBLIC_ENABLE_SMART_SORT=true
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true
NEXT_PUBLIC_ENABLE_CHALLENGES=true

# -----------------------------------------------------------------------------
# 7. SEEDING & ADMIN (Development Only)
# -----------------------------------------------------------------------------
# Credentials for the initial admin account created during database seeding.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

SEED_DEFAULT_PASSWORD="Password123!"
SEED_ADMIN_COUNT=2
SEED_CRITIC_COUNT=10
SEED_USER_COUNT=50
SEED_ITEMS_PER_USER=5

# -----------------------------------------------------------------------------
# 8. RATE LIMITING (Upstash Redis) - RECOMMENDED FOR PRODUCTION
# -----------------------------------------------------------------------------
# Get credentials from: https://console.upstash.com/redis
# Used for API rate limiting to prevent abuse

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# 9. OBSERVABILITY (Axiom) - RECOMMENDED FOR PRODUCTION
# -----------------------------------------------------------------------------
# Get credentials from: https://app.axiom.co/settings/api-tokens
# Used for structured API request logging and monitoring

NEXT_PUBLIC_AXIOM_DATASET=curator
NEXT_PUBLIC_AXIOM_TOKEN=
